'id':'2',
'prefix':'192.168.202',
'alias':'inf_vlan',
},
{
'name':'po1.0003',
'id':'3',
'prefix':'192.168.203',
'alias':'users_vlan',
},
{
'name':'po1.0004',
'id':'4',
'prefix':'192.168.204',
'alias':'voip_vlan',
},
{
'name':'po1.0005',
'id':'5',
'prefix':'192.168.205',
'alias':'iot_vlan',
},
{
'name':'po1.0006',
'id':'6',
