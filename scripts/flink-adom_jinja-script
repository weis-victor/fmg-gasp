'alias':'guest_vlan',
},
]
%}

config switch-controller fortilink-settings
    edit "po1"
      config nac-ports
          set onboarding-vlan "onboarding"
          set lan-segment enabled
          set nac-lan-interface "nac_segment"
          set nac-segment-vlans "voice" "video"
      end
   next
end

config fsp vlan
{% for vlan in vlans %}
    edit "{{vlan.name}}"
        set vlanid {{vlan.id}}
        set _dhcp-status enable
        config interface
            set ip {{vlan.prefix}}.1 255.255.255.0
            set allowaccess ping
            set description {{vlan.alias}}
            set alias {{vlan.alias}}
            set device-identification enable
            set role lan
            set ip-managed-by-fortiipam disable
        end
        config dhcp-server
            set dns-server1 192.168.199.2
            set dns-server2 1.1.1.1
            set dns-server3 8.8.8.8
            set domain "home.arpa"
            set default-gateway {{vlan.prefix}}.1
            set netmask 255.255.255.0
            set ntp-server1 192.168.199.1
            set timezone-option default
            config ip-range
                edit 1
                    set start-ip {{vlan.prefix}}.11
                    set end-ip {{vlan.prefix}}.250
                next
            end
        end
    next
    edit po1.0002
        config interface
            set allowaccess ping ssh https snmp fabric
        end
    next
    edit po1.0003
        config interface
            set allowaccess ping ssh https fabric
        end
    next
{% endfor %}
end
